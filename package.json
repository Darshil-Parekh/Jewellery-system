{
  "name": "jewellery-stock-manager",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm run start:dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:api": "npm run start:dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "db:up": "docker compose --env-file backend/.env up -d postgres",
    "db:down": "docker compose --env-file backend/.env down",
    "db:migrate": "npm run prisma:migrate --workspace backend",
    "db:generate": "npm run prisma:generate --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
